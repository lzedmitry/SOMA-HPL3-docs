---
import { appLocale, localeHref } from "../lib/locale";

const locale = appLocale(Astro.locals.starlightRoute.locale);
const steps = [
  { label: "3D model", href: "assets/modeling-overview" },
  { label: "Export", href: "assets/exporting-models" },
  { label: "Material", href: "materials" },
  { label: "Model Editor", href: "entities" },
  { label: "Entity", href: "entities/entity-types" },
  { label: "Animation", href: "assets/animation-principles" },
  { label: "Level", href: "level-building" },
];
---

<ol class="pipeline" aria-label="Asset pipeline">
  {
    steps.map((step, i) => (
      <li>
        <span class="pipeline-n">{String(i + 1).padStart(2, "0")}</span>
        <a href={localeHref(step.href, locale)}>{step.label}</a>
        {i < steps.length - 1 && <span class="pipeline-arrow" aria-hidden="true">↓</span>}
      </li>
    ))
  }
</ol>
