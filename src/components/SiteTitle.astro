---
import { appLocale, localeHref } from "../lib/locale";
import { t } from "../lib/ui-strings";

const locale = appLocale(Astro.locals.starlightRoute.locale);
const home = localeHref("index", locale);
---

<a href={home} class="site-title-lockup">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" fill="#071012"></rect>
    <circle cx="16" cy="16" r="11" fill="none" stroke="#6fa8a3" stroke-width="1.5"></circle>
    <circle cx="16" cy="16" r="4" fill="none" stroke="#6fa8a3" stroke-width="1.25"></circle>
    <circle cx="16" cy="16" r="1.4" fill="#6fa8a3"></circle>
    <rect x="23.5" y="6.5" width="3" height="3" fill="#bd7748"></rect>
  </svg>
  <span class="site-title-text">
    <span class="brand">SOMA / HPL3</span>
    <span class="sub">
      Modding archive
      <span class="unofficial-flag">{t("unofficial", locale)}</span>
    </span>
  </span>
</a>
